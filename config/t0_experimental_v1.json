{
  "version": "T0_EXPERIMENTAL_CONFIG_V1",
  "namespace": "FORWARD_VALIDATION",
  "database": "database/t0_forward_v1/t0_forward_v1.db",
  "runtime": "logs/t0_forward_v1",
  "spool": "raw/t0_forward_v1",
  "exports": "data/t0_forward_v1",
  "zuuu_endpoint": "https://aviationweather.gov/api/data/metar",
  "ecmwf_endpoint": "https://single-runs-api.open-meteo.com/v1/forecast",
  "zuuu_poll_seconds": 120,
  "ecmwf_poll_seconds": 1800,
  "zuuu_catchup_hours": 72,
  "ecmwf_catchup_runs": 8,
  "http_timeout_seconds": 15,
  "http_max_bytes": 8388608,
  "cycle_seconds": 10,
  "scheduled_hours_bjt": [8, 10, 12, 14, 16, 18],
  "schedule_grace_seconds": 120,
  "settlement_delay_days": 2,
  "observation_stale_seconds": 10800,
  "ecmwf_stale_seconds": 86400,
  "event_snapshots": true,
  "autostart_installed": false
}
