{
  "version": "PHASE10_REALTIME_V1",
  "timezone": "Asia/Shanghai",
  "database": "database/phase10_realtime_v1.db",
  "poll_seconds": 60,
  "zuuu_poll_seconds": 300,
  "ecmwf_poll_seconds": 1800,
  "connect_timeout": 10,
  "read_timeout": 45,
  "max_attempts": 3,
